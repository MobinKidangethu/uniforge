# Copy to .env and fill in. Never commit the real .env.

# --- GCP project this dashboard reads from ---
GCP_PROJECT_ID=your-gcp-project-id
# Bucket cloudbuild.yaml uploads APKs to (the _GCS_BUCKET substitution,
# without the gs:// prefix).
GCP_APK_BUCKET=your-project-apk-builds
# The Cloud Build trigger id created in the infra project (`gcloud builds
# triggers list` to find it). Used to filter the build list and to power
# the "Run build now" button. Leave blank to show all builds in the project.
CLOUD_BUILD_TRIGGER_ID=

# --- Google Sign-In (OAuth 2.0 Client ID, Web application) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback

# --- Who is allowed in ---
# Comma-separated list of exact emails, and/or a Workspace domain.
# A signed-in user is let in if their email is in ALLOWED_EMAILS OR their
# email's domain matches ALLOWED_DOMAIN. Set whichever you need; leave the
# other blank.
ALLOWED_EMAILS=you@example.com,teammate@example.com
ALLOWED_DOMAIN=

# Random long string used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

PORT=8080
